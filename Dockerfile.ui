FROM node:18-alpine

WORKDIR /app

# Copy UI package files
COPY ui/package*.json ./

# Install dependencies
RUN npm install

# Copy UI source
COPY ui/public ./public
COPY ui/src ./src

# Expose port
EXPOSE 3000

# Set environment variable
ENV REACT_APP_API_URL=http://localhost:3001

# Start the UI server
CMD ["npm", "start"]
